# Copy to .env (never commit the filled file). Double underscores map to configuration sections.

# ---- database ----------------------------------------------------------------
ConnectionStrings__Default=Host=localhost;Port=5432;Database=wonderfleet;Username=postgres;Password=postgres
# Render supplies a postgres:// URL; WonderFleet converts it automatically.
# ConnectionStrings__Default=postgres://user:pass@host:5432/wonderfleet
Database__SslMode=Prefer

# ---- Supabase --------------------------------------------------------------
# Use the SESSION pooler (port 5432) from Supabase's "Connect" dialog. The username carries
# the project ref, and the host is the pooler, not db.<ref>.supabase.co (that one is IPv6-only
# and most hosts cannot reach it).
# ConnectionStrings__Default=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Database__SslMode=Require
#
# If you use the TRANSACTION pooler instead (port 6543), also set this — that pooler gives each
# transaction a different backend, so prepared statements and session reset must be off:
# Database__TransactionPooling=true

# ---- app ---------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
App__FrontendBaseUrl=http://localhost:5173
App__PublicApiBaseUrl=http://localhost:8080
App__AllowedOrigins__0=http://localhost:5173

# ---- secrets (generate with: openssl rand -base64 48) -------------------------
Jwt__AdminSigningKey=
Jwt__PortalSigningKey=
Security__TokenHashKey=
Security__MediaSigningKey=

# ---- the single seeded administrator (no registration endpoint) --------------
Seed__AdminEmail=ofeminiagrictech@gmail.com
Seed__AdminPassword=Oagrictech@2026

# ---- hardware feed (Realtime Database) ---------------------------------------
Firebase__DatabaseUrl=https://wonderfleet-12693-default-rtdb.europe-west1.firebasedatabase.app
# Service account JSON, raw or base64. Leave empty and set AllowUnauthenticated=true for open prototype rules.
Firebase__ServiceAccountJson=
Firebase__AllowUnauthenticated=false
Telemetry__PollingEnabled=true
Telemetry__PollIntervalSeconds=10
# Optional signed push endpoint instead of polling
Telemetry__WebhookSecret=

# ---- Google Maps Platform (Geocoding, Places, Routes, Weather) ---------------
Google__ApiKey=

# ---- OpenAI (route optimisation; a heuristic runs when this is empty) --------
OpenAi__ApiKey=
OpenAi__Model=gpt-4.1-mini

# ---- email (Resend) ----------------------------------------------------------
Email__Provider=ResendApi
Email__ApiKey=
Email__From=WonderFleet <alerts@ofeminiagrictech.com>

# ---- SMS (Termii or Twilio) --------------------------------------------------
Sms__Provider=Termii
Sms__Termii__ApiKey=
Sms__Termii__SenderId=WonderFleet
Sms__Termii__Channel=dnd
# Sms__Provider=Twilio
# Sms__Twilio__AccountSid=
# Sms__Twilio__AuthToken=
# Sms__Twilio__FromNumber=
